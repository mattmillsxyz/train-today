    {
      "id": "dynamicWarmup",
      "name": "Dynamic Warmup",
      "tag": "warmup",
      "displayDuration": "8 min",
      "estimatedMinutes": 8,
      "mode": "stepped",
      "prMetric": null,
      "steps": [
        {
          "text": "Jog in place for 1 minute to get your heart rate up.",
          "role": "action",
          "media": null,
          "timing": {
            "type": "work",
            "seconds": 60
          }
        },
        {
          "text": "High knees: lift each knee up to your belly button while jogging, for 30 seconds.",
          "role": "action",
          "media": null,
          "timing": {
            "type": "work",
            "seconds": 30
          }
        },
        {
          "text": "Butt kicks: kick your heels up toward your butt while jogging, for 30 seconds.",
          "role": "action",
          "media": null,
          "timing": {
            "type": "work",
            "seconds": 30
          }
        },
        {
          "text": "Leg swings: hold a wall or fence, swing each leg forward and back 10 times.",
          "role": "action",
          "media": null,
          "timing": {
            "type": "reps",
            "count": 10,
            "each": "leg"
          }
        },
        {
          "text": "Arm circles: big circles forward 10 times, then backward 10 times.",
          "role": "action",
          "media": null,
          "timing": {
            "type": "reps",
            "count": 10,
            "each": "direction"
          }
        },
        {
          "text": "Hip circles: hands on hips, make big circles with your hips, 10 each way.",
          "role": "action",
          "media": null,
          "timing": {
            "type": "reps",
            "count": 10,
            "each": "direction"
          }
        },
        {
          "text": "Lateral shuffles: side-step quickly back and forth, for 30 seconds.",
          "role": "action",
          "media": null,
          "timing": {
            "type": "work",
            "seconds": 30
          }
        }
      ],
      "media": null
    },
    {
      "id": "jugglingBasic",
      "name": "Juggling Practice",
      "tag": "soccer",
      "displayDuration": "10 min",
      "estimatedMinutes": 10,
      "mode": "openBlock",
      "prMetric": {
        "label": "Best juggling streak",
        "unit": "count",
        "higherIsBetter": true
      },
      "steps": [
        {
          "text": "Drop the ball, let it bounce once, then kick it up with the top of your foot (laces). Catch it. Repeat.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Once you feel comfortable, try to kick it twice before catching it.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Keep your foot flat when you kick. Imagine your foot is a shelf the ball sits on.",
          "role": "cue",
          "media": null,
          "timing": null
        },
        {
          "text": "Count your best streak! Write it down and try to beat it tomorrow.",
          "role": "cue",
          "media": null,
          "timing": null
        },
        {
          "text": "If you get good, try alternating feet: right, left, right, left.",
          "role": "action",
          "media": null,
          "timing": null
        }
      ],
      "media": null
    },
    {
      "id": "coneDribbling",
      "name": "Cone Dribbling",
      "tag": "soccer",
      "displayDuration": "12 min · 3 sets",
      "estimatedMinutes": 12,
      "mode": "stepped",
      "prMetric": {
        "label": "Fastest cone run",
        "unit": "seconds",
        "higherIsBetter": false
      },
      "steps": [
        {
          "text": "Set up 5 cones (or water bottles, shoes, anything!) in a straight line, about 3 feet apart.",
          "role": "setup",
          "media": null,
          "timing": null
        },
        {
          "text": "Dribble through them using only the inside of your foot. Go slow and controlled first.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Come back through using the outside of your foot.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Rest 30 seconds, then repeat. Try to go a little faster each set.",
          "role": "action",
          "media": null,
          "timing": {
            "type": "loop",
            "repeatFrom": 2,
            "rounds": 3,
            "rest": 30,
            "restEvery": 1
          }
        },
        {
          "text": "Bonus: time yourself and try to beat your record!",
          "role": "cue",
          "media": null,
          "timing": null
        }
      ],
      "media": null
    },
    {
      "id": "wallPassing",
      "name": "Wall Passing",
      "tag": "soccer",
      "displayDuration": "10 min",
      "estimatedMinutes": 10,
      "mode": "openBlock",
      "prMetric": null,
      "steps": [
        {
          "text": "Stand about 6 feet from a wall or rebounder.",
          "role": "setup",
          "media": null,
          "timing": null
        },
        {
          "text": "Pass the ball firmly against the wall with the inside of your foot.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Control the return with your opposite foot. Soft touch!",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Try 20 passes with your right foot, then 20 with your left foot.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Move back a few feet once you're comfortable and repeat.",
          "role": "action",
          "media": null,
          "timing": null
        }
      ],
      "media": null
    },
    {
      "id": "shootingDrill",
      "name": "Shooting Practice",
      "tag": "soccer",
      "displayDuration": "10 min",
      "estimatedMinutes": 10,
      "mode": "openBlock",
      "prMetric": null,
      "steps": [
        {
          "text": "Set up a goal (use cones or pick a spot on a wall/fence).",
          "role": "setup",
          "media": null,
          "timing": null
        },
        {
          "text": "Start 10 feet away. Shoot using your laces and make sure you follow through!",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Take 10 shots from straight on, then 10 from the left side, then 10 from the right.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "After each shot, jog to get the ball. Don't just walk!",
          "role": "cue",
          "media": null,
          "timing": null
        },
        {
          "text": "Try aiming for corners (low left, low right) instead of straight at the middle.",
          "role": "cue",
          "media": null,
          "timing": null
        }
      ],
      "media": null
    },
    {
      "id": "firstTouchDrill",
      "name": "First Touch Drill",
      "tag": "soccer",
      "displayDuration": "10 min",
      "estimatedMinutes": 10,
      "mode": "openBlock",
      "prMetric": null,
      "steps": [
        {
          "text": "Toss the ball up in the air about head height. Let it drop.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Stop the ball dead with the sole (bottom) of your foot before it bounces twice.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Then try stopping it with the inside of your foot.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Do 15 reps each foot. The goal is a soft, controlled touch, not kicking it away.",
          "role": "action",
          "media": null,
          "timing": {
            "type": "reps",
            "count": 15,
            "each": "foot"
          }
        },
        {
          "text": "Challenge: toss higher and try to chest-trap it, then foot trap before it bounces.",
          "role": "cue",
          "media": null,
          "timing": null
        }
      ],
      "media": null
    },
    {
      "id": "insideOutsideDribble",
      "name": "Inside/Outside Dribble",
      "tag": "soccer",
      "displayDuration": "10 min",
      "estimatedMinutes": 10,
      "mode": "openBlock",
      "prMetric": null,
      "steps": [
        {
          "text": "In an open space, dribble forward tapping the ball with the inside of your right foot, then the outside.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Inside tap, outside tap, inside tap, outside tap. Keep a rhythm.",
          "role": "cue",
          "media": null,
          "timing": null
        },
        {
          "text": "Do this for 20 yards, then turn around and come back.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Repeat 4 times, then switch to your left foot.",
          "role": "action",
          "media": null,
          "timing": {
            "type": "reps",
            "count": 4,
            "each": "foot"
          }
        },
        {
          "text": "This improves your ball control and makes you harder to defend.",
          "role": "cue",
          "media": null,
          "timing": null
        }
      ],
      "media": null
    },
    {
      "id": "routeRunning",
      "name": "Route Running",
      "tag": "football",
      "displayDuration": "10 min",
      "estimatedMinutes": 10,
      "mode": "openBlock",
      "prMetric": null,
      "steps": [
        {
          "text": "Set up 2 cones: one where you start, one 10 yards ahead.",
          "role": "setup",
          "media": null,
          "timing": null
        },
        {
          "text": "Run hard to the cone, then cut sharply to the right (out route). Raise your hands like you're catching.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Jog back. Repeat, this time cutting to the left.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Do 6 reps each direction. Focus on planting your outside foot hard before cutting.",
          "role": "action",
          "media": null,
          "timing": {
            "type": "reps",
            "count": 6,
            "each": "direction"
          }
        },
        {
          "text": "Advanced: add a third cone and practice a corner route. Go straight, then cut out at 45°.",
          "role": "cue",
          "media": null,
          "timing": null
        }
      ],
      "media": null
    },
    {
      "id": "handCatching",
      "name": "Catching Drills",
      "tag": "football",
      "displayDuration": "10 min",
      "estimatedMinutes": 10,
      "mode": "openBlock",
      "prMetric": null,
      "steps": [
        {
          "text": "Toss a football up and catch with just your fingertips, not your palms.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Run 5 yards, turn around, catch a toss. Eyes on the ball the whole time, not the catcher.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Try catching while looking away, then turning at the last second.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "10 catches straight on, then run routes and catch: 5 cuts left, 5 cuts right.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Remember: catch the ball, THEN tuck it in. Don't tuck early!",
          "role": "cue",
          "media": null,
          "timing": null
        }
      ],
      "media": null
    },
    {
      "id": "footballAgility",
      "name": "Football Agility",
      "tag": "football",
      "displayDuration": "10 min",
      "estimatedMinutes": 10,
      "mode": "stepped",
      "prMetric": null,
      "steps": [
        {
          "text": "Set up 4 cones in a square about 5 yards apart.",
          "role": "setup",
          "media": null,
          "timing": null
        },
        {
          "text": "Sprint forward to the first cone, shuffle sideways to the second, backpedal to the third, shuffle back to start.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "This is called a 4-corner drill. It's used by real NFL players!",
          "role": "cue",
          "media": null,
          "timing": null
        },
        {
          "text": "Do 4 rounds, resting 30 seconds between each.",
          "role": "action",
          "media": null,
          "timing": {
            "type": "loop",
            "repeatFrom": 2,
            "rounds": 4,
            "rest": 30,
            "restEvery": 1
          }
        },
        {
          "text": "Try to keep your hips low and stay on the balls of your feet. No flat-footed running!",
          "role": "cue",
          "media": null,
          "timing": null
        }
      ],
      "media": null
    },
    {
      "id": "sprintIntervals",
      "name": "Sprint Intervals",
      "tag": "cardio",
      "displayDuration": "12 min",
      "estimatedMinutes": 12,
      "mode": "stepped",
      "prMetric": null,
      "steps": [
        {
          "text": "Find a flat area: a backyard, street, or park works great.",
          "role": "setup",
          "media": null,
          "timing": null
        },
        {
          "text": "Mark a start and end point about 30-40 yards apart.",
          "role": "setup",
          "media": null,
          "timing": null
        },
        {
          "text": "Sprint as FAST as you can from one end to the other.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Walk back slowly. This is your rest.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Do 8 sprints total. Rest 45 seconds after every 2 sprints.",
          "role": "action",
          "media": null,
          "timing": {
            "type": "loop",
            "repeatFrom": 3,
            "rounds": 8,
            "rest": 45,
            "restEvery": 2
          }
        }
      ],
      "media": null
    },
    {
      "id": "bikeRide",
