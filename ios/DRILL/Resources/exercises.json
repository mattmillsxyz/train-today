            "type": "work",
            "seconds": 300
          }
        },
        {
          "text": "Try to explore a slightly different route each time!",
          "role": "cue",
          "media": null,
          "timing": null
        }
      ],
      "media": null
    },
    {
      "id": "suicideSprints",
      "name": "Suicide Sprints",
      "tag": "cardio",
      "displayDuration": "10 min",
      "estimatedMinutes": 10,
      "mode": "stepped",
      "prMetric": {
        "label": "Fastest suicide",
        "unit": "seconds",
        "higherIsBetter": false
      },
      "steps": [
        {
          "text": "Set up 4 cones in a line: 5 yards, 10 yards, 15 yards, and 20 yards from your start.",
          "role": "setup",
          "media": null,
          "timing": null
        },
        {
          "text": "Sprint to the first cone, touch it (or the ground), sprint back to start.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Sprint to the second cone, back to start. Then third, then fourth.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "That's 1 full suicide. Rest 45 seconds and repeat.",
          "role": "action",
          "media": null,
          "timing": {
            "type": "loop",
            "repeatFrom": 2,
            "rounds": 4,
            "rest": 45,
            "restEvery": 1
          }
        },
        {
          "text": "Try to complete 3-4 suicides. These are tough, so give everything!",
          "role": "cue",
          "media": null,
          "timing": null
        }
      ],
      "media": null
    },
    {
      "id": "agilityLadder",
      "name": "Agility Ladder Work",
      "tag": "cardio",
      "displayDuration": "10 min",
      "estimatedMinutes": 10,
      "mode": "stepped",
      "prMetric": null,
      "steps": [
        {
          "text": "No ladder? Use chalk or tape on the ground to make 10 boxes, each about 18 inches.",
          "role": "setup",
          "media": null,
          "timing": null
        },
        {
          "text": "Run through stepping one foot in each box as fast as you can.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Try lateral shuffles: step side to side through each box.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Try the in-in-out-out pattern: both feet in, both feet out the sides, repeat.",
          "role": "action",
          "media": null,
          "timing": null
        },
        {
          "text": "Rest 20 seconds between each pass. Do 3 passes of each pattern.",
          "role": "action",
          "media": null,
          "timing": {
            "type": "loop",
            "repeatFrom": 2,
            "rounds": 3,
            "rest": 20,
            "restEvery": 1
          }
        }
      ],
      "media": null
    },
    {
      "id": "boxJumps",
      "name": "Box Jumps",
      "tag": "plyo",
      "displayDuration": "8 min · 3×8",
      "estimatedMinutes": 8,
      "mode": "stepped",
      "prMetric": {
        "label": "Highest box",
        "unit": "inches",
        "higherIsBetter": true
      },
      "steps": [
        {
          "text": "Find a sturdy box, step, or ledge about 12-18 inches high.",
          "role": "setup",
          "media": null,
          "timing": null
        },
        {
          "text": "Stand about 1 foot in front. Bend your knees, swing your arms back.",
          "role": "form",
          "media": null,
          "timing": null
        },
        {
          "text": "Explode up: swing arms forward, jump, and land SOFTLY on top with bent knees.",
          "role": "form",
          "media": null,
          "timing": null
        },
        {
          "text": "Step back down (don't jump down). Reset and go again.",
          "role": "form",
          "media": null,
          "timing": null
        },
        {
          "text": "Do 8 jumps, rest 30 seconds, repeat 3 times. LAND SOFT, no loud thuds!",
          "role": "action",
          "media": null,
          "timing": {
            "type": "interval",
            "work": null,
            "reps": 8,
            "each": null,
            "rest": 30,
            "rounds": 3
          }
        }
      ],
      "media": null
    },
